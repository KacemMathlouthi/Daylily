{
  "name": "daylily",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "dev": "turbo dev",
    "fix": "ultracite fix",
    "journal:seed": "pnpm --filter @daylily/desktop journal:seed",
    "journal:unseed": "pnpm --filter @daylily/desktop journal:unseed",
    "knip": "knip",
    "prepare": "lefthook install",
    "release": "semantic-release",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @daylily/desktop test:e2e",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "semantic-release": "25.0.9",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "ultracite": "8.0.1"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  }
}
