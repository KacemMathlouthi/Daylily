{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    // brand/ holds assets only; the route tree is generated by the TanStack Router plugin;
    // .claude/worktrees holds other checkouts of this repo
    "includes": ["!brand", "!**/route-tree.gen.ts", "!.claude"]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "cn": "Import cn from @daylily/ui/lib/cn, which knows our theme scales."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      // Primitives come from the shadcn CLI. Keeping them close to upstream makes
      // updates painless, so the stricter style rules don't apply to them.
      "includes": ["packages/ui/src/primitives/**", "packages/ui/src/hooks/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "correctness": { "useExhaustiveDependencies": "off" },
          "performance": {
            "noJsxPropsBind": "off",
            "noNamespaceImport": "off"
          },
          "style": { "useConsistentTypeDefinitions": "off" },
          "suspicious": {
            "noDocumentCookie": "off",
            "noLeakedRender": "off",
            "noShadow": "off"
          }
        }
      }
    },
    {
      // The one place that configures the cn package
      "includes": ["packages/ui/src/lib/cn.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // The desktop app is not a Next.js app, so there is no next/image to prefer
      "includes": ["apps/desktop/**"],
      "linter": { "rules": { "performance": { "noImgElement": "off" } } }
    },
    {
      // TanStack Router reads paths from file names: day.$key.tsx is /day/$key
      "includes": ["apps/desktop/src/renderer/src/routes/**"],
      "linter": {
        "rules": { "style": { "useFilenamingConvention": "off" } }
      }
    }
  ]
}
