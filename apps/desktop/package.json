{
  "name": "@daylily/desktop",
  "version": "0.0.0-development",
  "private": true,
  "description": "Daylily, a human-first journal",
  "homepage": "https://github.com/KacemMathlouthi/Daylily",
  "license": "AGPL-3.0-only",
  "author": "Kacem Mathlouthi",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "journal:seed": "tsx scripts/seed-journal.mts",
    "journal:unseed": "tsx scripts/unseed-journal.mts",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win --x64",
    "package:win:installer": "electron-vite build && electron-builder --win nsis --x64",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@daylily/core": "workspace:*",
    "@daylily/ui": "workspace:*",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/router-plugin": "1.168.47",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "chokidar": "5.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.3",
    "zod": "4.6.7"
  },
  "desktopName": "daylily.desktop"
}
